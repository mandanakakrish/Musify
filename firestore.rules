rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Developer's picks: Anyone can read, writes allowed (managed by admin UI in app)
    match /devpicks/{docId} {
      allow read, write: if true;
    }

    // Allow the app to verify admin status
    match /admins/{docId} {
      allow read: if true;
      allow write: if false; // Kept secure: only editable via Firebase Console / Admin
    }

    // User root profile (e.g. users/mandankakrish28_gmail_com)
    match /users/{userId} {
      allow read, write: if true;
    }

    // All user subcollections (played_tracks, play_events, playlists, favorites)
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Protect all other root collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
