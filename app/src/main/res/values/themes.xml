<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MusicPlayer.Starting" parent="Theme.SplashScreen">
        <!-- Background color of the splash screen for 0ms instant display -->
        <item name="windowSplashScreenBackground">@color/splash_bg_dark</item>
        <!-- The glowing icon in the center -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/musify_logo_transparent</item>
        <!-- Switch to app theme seamlessly once loaded -->
        <item name="postSplashScreenTheme">@style/Theme.MusicPlayer</item>
    </style>

    <style name="Theme.MusicPlayer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window_background</item>
        <item name="android:colorBackground">@color/splash_bg_dark</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowSplashScreenBackground">@color/splash_bg_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/musify_logo_transparent</item>
    </style>

</resources>